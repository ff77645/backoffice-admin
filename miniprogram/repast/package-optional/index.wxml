<van-nav-bar
  title="套餐详情"
  left-arrow
  bind:click-left="navBack"
/>
<scroll-view 
  class="scrollable bg-slate-50" 
  scroll-y
>
  <swiper indicator-dots class="" style="height: 280px;">
    <swiper-item wx:for="{{headImages}}" wx:key="index">
      <image class="w-full h-full object-center object-cover" src="{{item.src}}" mode="aspectFill"/>
    </swiper-item>
  </swiper>
  <view class="m-4 mb-3 bg-white rounded-md p-3">
    <view class="text-lg font-bold">{{packageInfo.title}}</view>
    <view class="text-gray-800">{{packageInfo.describe}}</view>
  </view>
  <view class="p-4">
    <view class="text-gray-900 text-sm mb-2">套餐商品:</view>
    <view class="p-2 bg-white rounded-md">
      <view class="flex items-center justify-between mb-1" wx:for="{{goodsList}}" wx:key="index">
        <view>
          <view class="text-sm">{{item.product.title}}</view>
          <view class="flex items-center gap-4">
            <view class="text-sm text-red-500 font-bold">￥{{item.product.retail_price / 100}}</view>
            <view class="text-gray-800 text-sm">x {{item.number}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="mt-3 p-2 bg-white rounded-md" wx:for="{{groupList}}" wx:key="index" wx:for-item="group">
      <view class="flex items-center text-gray-800 mb-2">
        <view class="">{{group.name}}</view>
        <view class="ml-3 text-sm">
          {{group.total}} 选 {{group.optional}}
        </view>
      </view>
      <view>
        <view class="flex items-center justify-between mb-1" wx:for="{{group.children}}" wx:key="index">
          <view>
            <view class="text-sm">{{item.product.title}}</view>
            <view class="flex items-center gap-4">
              <view class="text-sm text-red-500 font-bold">￥{{item.product.retail_price / 100}}</view>
              <view class="text-gray-800 text-sm">x {{item.number}}</view>
            </view>
          </view>
          <van-checkbox
            value="{{ item.checked }}"
            checked-color="#07c160"
            bind:change="onChange"
            data-group-id="{{item.group_id}}"
            data-id="{{item.id}}"
          ></van-checkbox>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
<view style="height:50px;"></view>
<view class="safe-area-inset-bottom"></view>
<van-goods-action>
  <van-goods-action-button text="添加" bind:click="onSubmit" />
</van-goods-action>